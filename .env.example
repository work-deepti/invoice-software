# PostgreSQL connection string.
# Supabase: use the "Transaction pooler" URI (port 6543).  Neon: use the pooled connection string.
# Local Mac (Homebrew): postgresql://localhost:5432/gsb_dev   (no user name needed)
DATABASE_URL=postgresql://localhost:5432/gsb_dev

# Secret used to sign session cookies (32+ random characters):  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: max connections per serverless instance
# DATABASE_POOL_MAX=5

# Integration tests: a SEPARATE, throwaway database (its name must contain "test").
# The test run drops and re-creates its schema.
TEST_DATABASE_URL=postgresql://localhost:5432/gsb_test
